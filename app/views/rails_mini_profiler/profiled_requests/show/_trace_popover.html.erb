<div class="popover" data-popover-target="popover">
  <section class="popover-header">
    <h1 class="popover-description"><%= break_opportunities(trace.description) %></h1>
    <button class="popover-close">x</button>
  </section>
  <section class="popover-body">
    <%= trace.content %>

    <% if trace.backtrace %>
      <section class="popover-footer">
        <div
          class="backtrace"
          data-controller="clipboard"
          data-clipboard-filter=".+?(?=:in)"
          data-clipboard-copied-message="Copied" >
          <pre data-clipboard-target="source"><%= break_opportunities(trace.backtrace) %></pre>
          <button
            title="Copy to clipboard"
            type="button"
            data-action="clipboard#copy"
            data-clipboard-target="button"
          >
            <%= icon('copy') %>
          </button>
        </div>
        <% if trace.full_backtrace.size > 1 %>
          <details class="backtrace-details">
            <summary>Full backtrace (<%= trace.full_backtrace.size %> frames)</summary>
            <pre><%= break_opportunities(trace.full_backtrace.join("\n")) %></pre>
          </details>
        <% end %>
      </section>
    <% end %>

    <table class="trace-details-table">
      <thead>
      <tr>
        <th class="text-left"></th>
        <th class="text-right">Response Time</th>
        <th class="text-right">Allocations</th>
      </tr>
      </thead>
      <tbody>
      <tr>
        <td>Total</td>
        <td class="text-right"><%= trace.duration %>ms</td>
        <td class="text-right"><%= trace.allocations %></td>
      </tr>
      <tr>
        <td>Relative</td>
        <td class="text-right"><%= trace.duration_percent %>%</td>
        <td class="text-right"><%= trace.allocations_percent %>%</td>
      </tr>
      <tr>
        <td>Started</td>
        <td class="text-right">+<%= trace.from_start.round(1) %>ms</td>
        <td class="text-right"></td>
      </tr>
      </tbody>
    </table>
  </section>
</div>
