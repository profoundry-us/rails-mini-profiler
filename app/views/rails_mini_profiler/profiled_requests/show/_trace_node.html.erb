<%#
  Renders a single node of the trace tree, recursing into its children (or, for a group node, its members).
  Structural nodes render expanded; group nodes (repeated siblings) render collapsed so they stay compact.

  The bar tracks share one aligned column (indentation lives in the label column only), and each bar is
  offset by its start time — so child bars render inside their parent's span, and gaps within a parent's
  bar are its self time (work no tracer instrumented). Group bars span first-member-start to
  last-member-finish and are drawn muted, since their members are scattered across that window.

  `node` is a RailsMiniProfiler::TraceTree::Node; `depth` is the nesting level (0 for roots).
%>
<% depth ||= 0 %>
<% expandable = node.group? || node.children.any? %>
<% expanded = expandable && !node.group? %>
<% request_start = @profiled_request.start.to_i %>
<% window = [@profiled_request.finish.to_i - request_start, 1].max %>
<% bar_left = ((node.span_start - request_start) * 100.0 / window).clamp(0, 100).round(2) %>
<% bar_width = ((node.span_finish - node.span_start) * 100.0 / window).round(2) %>
<li class="trace-node <%= node.trace.type %><%= ' trace-node--group' if node.group? %><%= ' trace-node--expanded' if expanded %>" style="--trace-depth: <%= depth %>;" data-controller="popover tree">
  <div class="trace-node-row">
    <span class="trace-node-label">
      <% if expandable %>
        <button
          type="button"
          class="trace-toggle"
          data-action="tree#toggle"
          data-tree-target="toggle"
          aria-expanded="<%= expanded %>"
          aria-label="Toggle children"
        >&#9656;</button>
      <% else %>
        <span class="trace-toggle-spacer"></span>
      <% end %>

      <span class="trace-node-name" title="<%= node.trace.label %>">
        <%= break_opportunities(node.trace.label) %><% if node.group? %> <span class="trace-node-count">&times;<%= node.count %></span><% end %>
      </span>
    </span>

    <div class="trace-node-track">
      <div
        class="trace-bar<%= ' trace-bar--span' if node.group? %>"
        style="left: min(<%= bar_left %>%, calc(100% - 3px)); width: max(<%= bar_width %>%, 3px)"
        data-popover-target="clickable"
      ></div>
      <% if node.group? %>
        <%# Solid ticks mark where each member actually ran (and how long), inside the faint window. %>
        <% node.members.each do |member| %>
          <% tick_left = ((member.span_start - request_start) * 100.0 / window).clamp(0, 100).round(2) %>
          <% tick_width = ((member.span_finish - member.span_start) * 100.0 / window).round(2) %>
          <div
            class="trace-bar trace-bar--tick"
            style="left: min(<%= tick_left %>%, calc(100% - 2px)); width: max(<%= tick_width %>%, 2px)"
          ></div>
        <% end %>
      <% end %>
    </div>

    <span class="trace-node-meta">
      <% if !node.group? && node.children.any? && node.self_duration >= 100 %>
        <span class="trace-node-self" title="Time not covered by any instrumented child event">self <%= formatted_duration(node.self_duration) %>ms</span>
      <% end %>
      <span class="trace-node-duration"><%= formatted_duration(node.total_duration) %>ms</span>
    </span>

    <% if node.group? %>
      <%= render "rails_mini_profiler/profiled_requests/show/group_popover", node: node, request_start: request_start %>
    <% else %>
      <%= render "rails_mini_profiler/profiled_requests/show/trace_popover", trace: node.trace %>
    <% end %>
  </div>

  <% if expandable %>
    <ol class="trace-node-children<%= ' hidden' unless expanded %>" data-tree-target="children">
      <% (node.group? ? node.members : node.children).each do |child| %>
        <%= render "rails_mini_profiler/profiled_requests/show/trace_node", node: child, depth: depth + 1 %>
      <% end %>
    </ol>
  <% end %>
</li>
